#!/usr/bin/env bash
# Copyright (C) 2026 Alexander Mäule <alex@software-by-design.de>
# SPDX-License-Identifier: AGPL-3.0-or-later
# Register Cinnamon keyboard shortcuts for Prompt Vault slots 1–9.
set -euo pipefail

HOTKEY_CMD="${PROMPT_VAULT_HOTKEY_CMD:-${HOME}/.local/bin/prompt-vault-hotkey}"
DATA_DIR="${PROMPT_VAULT_DATA_DIR:-}"
# Super+Ctrl+1–9 avoids conflicts with Super+1–9 (app switch) and Super+Shift+* (Mint/Cinnamon).
KEY_COMBO="${PROMPT_VAULT_KEY_COMBO:-Super+Ctrl}"

usage() {
  cat <<EOF
Usage: prompt-vault-setup-shortcuts

Registers Cinnamon custom shortcuts (default: Super+Ctrl+1 … Super+Ctrl+9).
Override combo: PROMPT_VAULT_KEY_COMBO='Super+Alt' $0

Environment:
  PROMPT_VAULT_HOTKEY_CMD   path to prompt-vault-hotkey
  PROMPT_VAULT_DATA_DIR     custom prompts data directory
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ ! -x "${HOTKEY_CMD}" ]]; then
  echo "error: prompt-vault-hotkey not found or not executable: ${HOTKEY_CMD}" >&2
  echo "Run ./install.sh from the prompt-vault repo first." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required to register Cinnamon shortcuts." >&2
  exit 1
fi

# Map KEY_COMBO like "Super+Ctrl" to gsettings token "<Super><Ctrl>".
combo_tokens() {
  local raw="$1"
  local out=""
  local part
  IFS='+' read -ra parts <<< "${raw}"
  for part in "${parts[@]}"; do
    part="$(echo "${part}" | sed 's/^ *//;s/ *$//')"
    [[ -z "${part}" ]] && continue
    case "${part}" in
      Super|super|Mod4) out+="<Super>" ;;
      Ctrl|ctrl|Control) out+="<Ctrl>" ;;
      Alt|alt) out+="<Alt>" ;;
      Shift|shift) out+="<Shift>" ;;
      *)
        echo "error: unsupported key combo part: ${part}" >&2
        exit 1
        ;;
    esac
  done
  printf '%s' "${out}"
}

COMBO_PREFIX="$(combo_tokens "${KEY_COMBO}")"
if [[ -z "${COMBO_PREFIX}" ]]; then
  echo "error: PROMPT_VAULT_KEY_COMBO is empty or invalid." >&2
  exit 1
fi

export PROMPT_VAULT_HOTKEY_CMD="${HOTKEY_CMD}"
export PROMPT_VAULT_DATA_DIR="${DATA_DIR}"
export PROMPT_VAULT_COMBO_PREFIX="${COMBO_PREFIX}"

python3 - <<'PY'
# Register relocatable custom-keybinding schemas. Do not parse `gsettings get`
# with tr -d "[]'" — an empty list is `@as []`, which that turns into a bogus
# `@as` id and can leave Cinnamon's custom-list unusable.
from __future__ import annotations

import os
import shlex
import sys

try:
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
except Exception as exc:  # pragma: no cover - environment
    sys.stderr.write(f"error: python3-gi (Gio) is required: {exc}\n")
    sys.exit(1)

PARENT = "org.cinnamon.desktop.keybindings"
CHILD = "org.cinnamon.desktop.keybindings.custom-keybinding"
BASE = "/org/cinnamon/desktop/keybindings/custom-keybindings/"
JUNK_IDS = {"", "@as", "__dummy__"}

hotkey = os.environ["PROMPT_VAULT_HOTKEY_CMD"]
data_dir = os.environ.get("PROMPT_VAULT_DATA_DIR", "").strip()
combo = os.environ["PROMPT_VAULT_COMBO_PREFIX"]

kb = Gio.Settings.new(PARENT)
existing = [i for i in kb.get_strv("custom-list") if i not in JUNK_IDS]

for slot in range(1, 10):
    ident = f"prompt-vault-slot{slot}"
    if ident not in existing:
        existing.append(ident)
    settings = Gio.Settings.new_with_path(CHILD, f"{BASE}{ident}/")
    cmd = f"{shlex.quote(hotkey)} {slot}"
    if data_dir:
        cmd = f"env PROMPT_VAULT_DATA_DIR={shlex.quote(data_dir)} {cmd}"
    settings.set_string("name", f"Prompt Vault: Slot {slot}")
    settings.set_string("command", cmd)
    settings.set_strv("binding", [f"{combo}{slot}"])

# Cinnamon reloads custom shortcut commands only when custom-list changes.
kb.set_strv("custom-list", existing)
kb.set_strv("custom-list", ["__dummy__"])
kb.set_strv("custom-list", existing)
Gio.Settings.sync()

final = [i for i in kb.get_strv("custom-list") if i not in JUNK_IDS]
missing = [f"prompt-vault-slot{n}" for n in range(1, 10) if f"prompt-vault-slot{n}" not in final]
if missing:
    sys.stderr.write("error: failed to register shortcuts: " + ", ".join(missing) + "\n")
    sys.exit(1)
if "@as" in kb.get_strv("custom-list"):
    sys.stderr.write("error: custom-list still contains invalid id @as\n")
    sys.exit(1)
PY

echo "Prompt Vault keyboard shortcuts installed:"
echo "  ${KEY_COMBO}+1 … ${KEY_COMBO}+9  →  paste slot 1 … 9 into the focused field"
echo
echo "Focus a text field first, then press the shortcut."
echo "Change combos: Settings → Keyboard → Custom Shortcuts (Prompt Vault: Slot N)"
echo "Assign prompts: Prompt Vault → Edit prompt → Shortcut slot"
echo
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  if ! command -v wtype >/dev/null 2>&1 && ! command -v ydotool >/dev/null 2>&1; then
    echo "Note: install wtype or ydotool for auto-paste on Wayland."
  fi
elif ! command -v xdotool >/dev/null 2>&1; then
  echo "Note: auto-paste uses X11 (python3-xlib). Optional: sudo apt install xdotool"
fi
